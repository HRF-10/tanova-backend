# Tiga kunci rahasia dibuat otomatis dengan: npm run gen-secrets

# ===== Server =====
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Pisahkan dengan koma, atau * untuk semua origin (jangan dipakai di produksi)
CORS_ORIGIN=*

# ===== Keamanan (WAJIB diganti di produksi) =====
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_REFRESH_SECRET=ganti-dengan-string-acak-lain
JWT_ACCESS_EXPIRES=12h
JWT_REFRESH_EXPIRES=7d
# Kunci untuk mengenkripsi password ThingsBoard milik pengguna di database.
CREDENTIAL_ENCRYPTION_KEY=ganti-dengan-string-acak-ketiga

# ===== Database (Supabase) =====
DATABASE_URL=
# Supabase mewajibkan SSL. Ubah ke false hanya untuk PostgreSQL lokal tanpa SSL
DB_SSL=true
# Jumlah koneksi maksimal ke database (paket gratis Supabase terbatas)
DB_POOL_MAX=5
# true = buat dan perbarui tabel otomatis saat backend start
AUTO_MIGRATE=true

# ===== ThingsBoard =====
# true = data simulasi (untuk pengembangan frontend tanpa alat). Ubah ke false untuk memakai ThingsBoard asli.
THINGSBOARD_MOCK=false
TB_URL=https://thingsboard.cloud
TB_USERNAME=
TB_PASSWORD=
TB_RPC_MODE=twoway
TB_TIMEOUT_MS=8000
TB_KEY_PH=ph
TB_KEY_EC=ec
TB_KEY_TDS=tds
TB_KEY_WATER_TEMP=temp_water
TB_KEY_AIR_TEMP=temp_air
TB_KEY_HUMIDITY=humidity
TB_KEY_WATERFLOW=waterflow
# Belum ada sensornya di service_1.py: nilainya kosong sampai sensor level tangki ditambahkan
TB_KEY_TANK_LEVEL=tank_level
# TDS (ppm) = EC (mS/cm) x faktor. Dipakai karena service tidak mengirim TDS.
TDS_FACTOR=500
# Data sensor yang lebih tua dari ini (detik) dianggap basi dan nilainya dikosongkan
TELEMETRY_STALE_SECONDS=120
# Batas durasi dosis manual (detik), samakan dengan MANUAL_MAX_DURATION di raspi/.env
MANUAL_MAX_DURATION=300

# ===== Peringatan =====
# Pengecekan ambang batas sensor; hasilnya muncul sebagai notifikasi di aplikasi
ALERT_ENGINE_ENABLED=true
ALERT_CHECK_INTERVAL_SEC=30

# ===== Tanova AI eksternal (backend meneruskan foto ke layanan AI teman) =====
# URL layanan AI; backend akan POST multipart field "image" ke /api/analyze
TANOVAAI_URL=https://tanovaai.onrender.com
# API key dari pemilik layanan tanovaai (header x-api-key saat backend memanggil layanan)
TANOVAAI_API_KEY=
# Timeout request ke layanan AI (milidetik); sesuaikan dengan timeout yang diberikan teman
TANOVAAI_TIMEOUT_MS=60000
# Kunci terpisah untuk ESP32-CAM saat mengirim foto ke backend Tanova (header x-api-key)
CAMERA_API_KEY=
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ===== Seed =====
SEED_ADMIN_EMAIL=admin@tanova.local
SEED_ADMIN_PASSWORD=Admin12345!

# Username akun admin awal (seed)
SEED_ADMIN_USERNAME=admin

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=
CAMERA_API_KEY=