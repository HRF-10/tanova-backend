# ===== Simulator Tanova =====
# Nama variabel SAMA dengan raspi/.env, jadi nanti cukup menyalin isinya ke Raspberry Pi.
# Gunakan device ThingsBoard KHUSUS simulasi, jangan device milik Raspberry Pi sungguhan
# (dua pengirim dengan token yang sama akan saling menimpa data).

# Access token device simulasi (ThingsBoard: Devices > pilih device > Copy access token)
THINGSBOARD_TOKEN=
# Alamat MQTT. ThingsBoard Cloud: mqtt.thingsboard.cloud
THINGSBOARD_HOST=mqtt.thingsboard.cloud
# true -> memakai port 8883 (TLS). false -> port 1883
THINGSBOARD_TLS=false
# THINGSBOARD_PORT=1883
# Jeda kirim telemetri (detik)
THINGSBOARD_INTERVAL=10
# Batas durasi dosis manual (detik), samakan dengan MANUAL_MAX_DURATION di .env backend
MANUAL_MAX_DURATION=300
# Mode saat simulator pertama menyala: manual (bawaan, mudah menguji kontrol) atau auto
SIM_START_MODE=manual
