# ===== Identitas perangkat (WAJIB) =====
# Dipakai untuk topik MQTT lokal: <CLIENT_ID>/device-001 dan nama ESP: <CLIENT_ID>-001-sensor, <CLIENT_ID>-dc, <CLIENT_ID>-ac
CLIENT_ID=smartfarm-001
DEBUG=0

# ===== Broker MQTT untuk ESP/Wemos (sensor dan relay) =====
# Pilihan A: mosquitto lokal di Raspberry Pi (bawaan kode asli, port 1883 tanpa TLS)
LOCAL_MQTT_BROKER=localhost
LOCAL_MQTT_PORT=1883
LOCAL_MQTT_USERNAME=smartfarm
LOCAL_MQTT_PASSWORD=smartfarm*2023
#
# Pilihan B: broker online sistem lama. Hapus 4 baris LOCAL_MQTT_* di atas dan pakai baris ini.
# Port 8883 otomatis memakai TLS. Variabel MQTT_* sama dengan nama di .env sistem lama.
# MQTT_BROKER=70-mqtt.oemahsolution.com
# MQTT_PORT=8883
# MQTT_USERNAME=isi-user-lama
# MQTT_PASSWORD=isi-password-lama
# MQTT_TLS_INSECURE=false   # true hanya untuk uji bila sertifikat server tidak dikenali

# ===== ThingsBoard (MQTT) =====
# Access token device (Devices > pilih device > Copy access token)
THINGSBOARD_TOKEN=
# Host MQTT. Untuk ThingsBoard Cloud: mqtt.thingsboard.cloud. Untuk server sendiri: alamat server
THINGSBOARD_HOST=mqtt.thingsboard.cloud
THINGSBOARD_TLS=false
# THINGSBOARD_PORT=1883
THINGSBOARD_INTERVAL=10
THINGSBOARD_BUFFER=2000

# ===== Batas dosis manual dari website (detik). Samakan dengan MANUAL_MAX_DURATION di backend =====
MANUAL_MAX_DURATION=300
